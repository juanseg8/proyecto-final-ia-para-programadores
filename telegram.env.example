# Copy this file to local-ai/telegram.env and fill in real values.
# local-ai/telegram.env is gitignored - never commit real tokens.
#
# How to get these:
# 1. In Telegram, talk to @BotFather -> /newbot -> follow the prompts.
#    BotFather gives you a token that looks like 123456789:AAExampleToken
# 2. Send any message to your new bot from your own Telegram account.
# 3. Open in a browser (replace TOKEN):
#    https://api.telegram.org/botTOKEN/getUpdates
#    Look for "chat":{"id": ...} in the JSON response - that number is your chat id.

TELEGRAM_BOT_TOKEN=123456789:REPLACE_WITH_YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=REPLACE_WITH_YOUR_CHAT_ID
