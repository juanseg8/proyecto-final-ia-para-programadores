{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 900000
      },
      "models": {
        "agro-coder": {
          "name": "Agro Coder - Devstral Small 2 24B"
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B fallback"
        }
      }
    }
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "ollama/agro-coder",
      "permission": {
        "read": {
          "*": "allow",
          "*.env": "deny",
          "*.env.*": "deny",
          "*.env.example": "allow",
          "mobile/__tests__/**": "deny",
          "backend/**/*.spec.ts": "deny",
          "backend/test/**": "deny"
        },
        "edit": {
          "*": "deny",
          "backend/**": "allow",
          "mobile/**": "allow",
          "NIGHT_REPORT.md": "allow",
          "README.md": "allow",
          "night-agent-write-probe.txt": "allow",
          "mobile/__tests__/**": "deny",
          "backend/**/*.spec.ts": "deny",
          "backend/test/**": "deny",
          "night-agent-rewrite-probe.txt": "allow"
        },
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "lsp": "allow",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "npm run build*": "allow",
          "npx tsc*": "allow"
        },
        "task": "deny",
        "webfetch": "deny",
        "websearch": "deny",
        "external_directory": "deny",
        "question": "deny",
        "rewrite_file": "allow"
      },
      "prompt": "{file:./.opencode/prompts/build.txt}",
      "tools": {
        "read": true,
        "write": false,
        "edit": false,
        "rewrite_file": true,
        "glob": true,
        "grep": true,
        "list": true,
        "lsp": true,
        "bash": true,
        "task": false,
        "webfetch": false,
        "websearch": false
      }
    }
  }
}
