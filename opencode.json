{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "night-builder",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama Local",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 900000
      },
      "models": {
        "agro-coder": {
          "name": "Agro Coder - Devstral Small 2 24B"
        },
        "qwen3.5:9b": {
          "name": "Qwen 3.5 9B fallback"
        }
      }
    }
  }
}
